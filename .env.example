# ==============================================================
# SISTEMA DE GESTIÓN – PLAZA MEGATÓN
# Variables de Configuración de Entorno (.env)
# ==============================================================

# Puerto local del servidor
PORT=3007
NODE_ENV=development

# Clave de acceso al Panel Administrativo (/admin)
ADMIN_PIN=megaton2026

# Correo Oficial de Plaza Megatón y Configuración SMTP
# Si se dejan en blanco, el sistema usará el buzón seguro de pruebas Ethereal automáticamente
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=administracion@plazamegaton.com
SMTP_PASS=tu_contraseña_de_aplicacion_aqui

# Sincronización con Google Apps Script (Opción 1: Sin GCP, despliegue en 1 minuto)
# Pega aquí la URL de la aplicación web de Google Apps Script tras publicar Code.gs
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_SCRIPT_ID/exec

# Integración directa con Google Cloud APIs (Opción 2: Service Account)
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
